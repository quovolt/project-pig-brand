{
  "name": "project-pig-brand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project Pig brand documentation, powered by VitePress.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run typecheck && npm run docs:build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.5"
    }
  }
}
